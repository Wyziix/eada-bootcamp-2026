</main>
<script>
const downloads = {{ downloads | tojson }};
{% if market %}
const referenceInput = document.getElementById('reference-price-input');
referenceInput.addEventListener('input', () => {
  const value = Number(referenceInput.value);
  const valid = referenceInput.value.trim() !== '' && referenceInput.validity.valid && Number.isFinite(value);
  const format = number => new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(number);
  document.getElementById('reference-illustration').textContent = valid ? format(value) : '—';
  document.getElementById('market-illustration').textContent = valid ? format(value * {{ market.adjustment_factor | tojson }}) : '—';
});
{% endif %}
document.querySelectorAll('[data-download]').forEach(button => button.addEventListener('click', () => {
  const key = button.dataset.download;
  const url = URL.createObjectURL(new Blob([downloads[key]], {type:'text/csv;charset=utf-8;'}));
  const link = document.createElement('a'); link.href = url; link.download = `ames_${key}.csv`;
  document.body.appendChild(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
}));
document.getElementById('sort-models').addEventListener('change', event => {
  const body = document.querySelector('#model-table tbody');
  [...body.rows].sort((a,b) => Number(a.dataset[event.target.value])-Number(b.dataset[event.target.value])).forEach(row => body.appendChild(row));
});
document.getElementById('print-report').addEventListener('click', () => window.print());
document.querySelectorAll('details').forEach(detail => detail.addEventListener('toggle', () => {
  if(detail.open) detail.querySelectorAll('.plotly-graph-div').forEach(chart => Plotly.Plots.resize(chart));
}));
window.addEventListener('beforeprint', () => document.querySelectorAll('.plotly-graph-div').forEach(chart => Plotly.Plots.resize(chart)));
</script>
</body>
</html>
